# Polypad web app — copy to .env and fill in

# Deployed contracts (Robinhood Chain). Current factory and commit vault.
# Earlier factory: 0x2C84cFCD8d283EF750E09Fbed735d67F67845dB2
# Earlier commit vault: 0x8F125c9eC7acD52B9cd39f2a7441085559d84104
NEXT_PUBLIC_FACTORY_ADDRESS=0xfDfD0A095966c8B56639f7eAa13f4B0188Fc08c2
NEXT_PUBLIC_COMMIT_VAULT_ADDRESS=0xF013bF17D511E2f65D0dA4Bd320948646F567Ae4

# Fund factory (Phase 1a raise and mint). Optional: the fund pages use this
# recorded address when the variable is unset.
NEXT_PUBLIC_FUND_FACTORY_ADDRESS=0x6c0094BA60DaA0467Daf81f4D576d74DD3a08878

# Phase 2 invest factory. Not deployed. Leave this unset. The fund pages
# ignore an empty value and do not treat the Phase 1 factory as an invest factory.
# NEXT_PUBLIC_FUND_INVEST_FACTORY_ADDRESS=

# Chain. The agent launch API (POST /api/agents/v1/simulate) reads these for
# eth_call. It does not use a signing key.
NEXT_PUBLIC_CHAIN_ID=4663
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_EXPLORER_URL=https://robinhoodchain.blockscout.com

# Optional: WalletConnect project ID (https://cloud.reown.com). Without it, injected + deep-link wallets still work.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Public site URL (used for social preview metadata)
NEXTAUTH_URL=http://localhost:3000

# Token logo uploads (S3). Credentials come from the standard AWS chain
# (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY or AWS_PROFILE). The bucket must allow
# public reads and browser PUTs (CORS) from your site's origin.
AWS_REGION=us-east-1
AWS_BUCKET_NAME=
AWS_FOLDER_PREFIX=polypad/
