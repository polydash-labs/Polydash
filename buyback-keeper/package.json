{"dependencies":{"dotenv":"^16.4.5","viem":"^2.57.4"},"description":"Keeper for the PolydashBuybackVault on Robinhood Chain: runs the observePrice -> buy -> releaseToTarget cycle the vault needs from an external caller.","devDependencies":{"@types/node":"^22.10.0","tsx":"^4.19.2","typescript":"^5.6.3"},"engines":{"node":">=22"},"name":"@polypad/buyback-keeper","private":true,"scripts":{"autopilot":"tsx src/autopilot-run.ts","autopilot:dry-run":"tsx src/autopilot-run.ts --dry-run","build":"tsc -p tsconfig.build.json","start":"tsx src/index.ts","start:dry-run":"tsx src/index.ts --once --dry-run","start:once":"tsx src/index.ts --once","test":"node --import tsx --test tests/*.test.ts"},"type":"module","version":"0.1.0"}