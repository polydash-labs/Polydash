# PolyCTO env. Copy to .env and fill in locally. Never commit .env.
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
OPENAI_API_KEY=
MODEL_NAME=gpt-4o-mini

# Telegram mode only
TELEGRAM_BOT_TOKEN=

# Project the agent speaks for
PROJECT_NAME=
PROJECT_TOKEN_ADDRESS=
PROJECT_LINKS=

# Moderation is suggest-only unless this is true
POLYCTO_AUTO_MODERATE=false
POLYCTO_LOOKBACK=200000
POLYCTO_LOG_CHUNK=10000
