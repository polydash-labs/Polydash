# Copy to .env and fill in locally. NEVER commit .env.
# Prefer a hardware wallet or `cast wallet import` keystore over a raw key.
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
PRIVATE_KEY=0xYOUR_DEPLOYER_PRIVATE_KEY_HERE
FEE_RECIPIENT=0xYOUR_FEE_RECIPIENT_ADDRESS
UNSTAKE_FEE_BPS=100
# FundFactory (script/DeployFundFactory.s.sol) uses PRIVATE_KEY and FEE_RECIPIENT.
# It does not default the recipient. The launchpad platform fee wallet is
# 0x9a21c75aC263cC43125E70200636f6397f8776d0 — set FEE_RECIPIENT to that only if you mean to.
