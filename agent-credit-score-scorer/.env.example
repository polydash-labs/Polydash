# Agent Credit Score scorer — copy to .env and fill in.
# Never commit a real .env (it holds the keeper key).

# Required: AgentRegistry + AgentScore addresses (deploy first, then set).
REGISTRY_ADDRESS=
SCORE_ADDRESS=

# Required unless --dry-run: the keeper key that calls updateScore.
# Never log it, never write it to a file, never put it in chat.
KEEPER_PRIVATE_KEY=

# Optional overrides (defaults are the verified mainnet addresses).
# RPC_URL=https://rpc.mainnet.chain.robinhood.com
# FUND_FACTORIES=0xb9BA453677A6b2C49290CfD4D0713502Ec6bF82B,0xe50Da719947E83f316977d9c425DF95672E7B27e,0xB5251BaC3CFE2A057B7703D4477Bf80f10B8154B
# STAKING_FACTORIES=0x4C87aff7009DE1c58E052FEe202349a10b28Be9c,0x904b8F5d95B593b5F4a6Dbb116b58e1d5CBe93f0
# LAUNCH_FACTORY=0xfDfD0A095966c8B56639f7eAa13f4B0188Fc08c2
# POLYDASH_ADDRESS=0x319525528f42167eF7fC18b77b889958080568e4
# LOOKBACK_BLOCKS=200000
# OUTPUT_FILE=./data/scores.json
# LOG_FILE=./data/scorer.log.jsonl
